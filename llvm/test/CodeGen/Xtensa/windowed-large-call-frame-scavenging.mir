    $a3 = MOVI 3
    $a4 = MOVI 4
    $a5 = MOVI 5
    $a6 = MOVI 6
    $a8 = MOVI 8
    $a9 = MOVI 9
    $a10 = MOVI 10
    $a11 = MOVI 11
    $a12 = MOVI 12
    $a13 = MOVI 13
    $a14 = MOVI 14
    $a15 = MOVI 15
    J %bb.1
  bb.1:
    liveins: $a2, $a3, $a4, $a5, $a6, $a8, $a9, $a10, $a11, $a12, $a13, $a14, $a15
    ADJCALLSTACKDOWN 1200, 0, implicit-def dead $sp, implicit $sp
