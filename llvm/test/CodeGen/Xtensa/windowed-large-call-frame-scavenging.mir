    S32I $a3, $a2, 0
    S32I $a4, $a2, 4
    S32I $a5, $a2, 8
    S32I $a6, $a2, 12
    S32I $a8, $a2, 16
    S32I $a9, $a2, 20
    S32I $a10, $a2, 24
    S32I $a11, $a2, 28
    S32I $a12, $a2, 32
    S32I $a13, $a2, 36
    S32I $a14, $a2, 40
